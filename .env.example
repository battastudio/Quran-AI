# Optional: enable cloud login + cross-device sync (Firebase).
# Leave unset to run the app local-only (IndexedDB). Copy to `.env` and fill in
# from your Firebase project → Project settings → Your apps → Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=
